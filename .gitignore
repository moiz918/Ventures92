backend/**/*.pyo
backend/.mypy_cache/
backend/.ruff_cache/
backend/.pytest_cache/

# Next.js
frontend/.next/
frontend/out/
frontend/node_modules/

# Docker
*.log

# OS
.DS_Store
Thumbs.db
