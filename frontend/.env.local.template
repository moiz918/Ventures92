# =============================================================================
# Ventures 92 — Frontend Environment Template
# Copy to .env.local — never commit the real file.
# =============================================================================

# Accessed by the browser — points to the HOST-mapped port
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Accessed by Next.js server-side code INSIDE the Docker container
# (uses the internal Docker network service name "backend").
# Server Components, middleware, and Edge functions use this URL so cross-
# container traffic does not bounce through localhost. Required for both
# RSC data fetching and the silent refresh flow in middleware.ts.
INTERNAL_API_URL=http://backend:8000/api/v1
